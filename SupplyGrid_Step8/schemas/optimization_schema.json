{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id",
    "supplier_id",
    "agent",
    "status",
    "data",
    "evidence",
    "actions_executed"
  ],
  "properties": {
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "supplier_id": {
      "type": "string",
      "pattern": "^S[0-9]{3}$"
    },
    "agent": {
      "const": "optimization"
    },
    "status": {
      "const": "SUCCEEDED"
    },
    "actions_executed": {
      "const": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "path",
          "sha256"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "required": [
        "status",
        "solver",
        "plan",
        "audit",
        "objective_value",
        "actions_executed",
        "recommendation_only"
      ],
      "properties": {
        "status": {
          "enum": [
            "OPTIMAL",
            "FEASIBLE"
          ]
        },
        "solver": {
          "type": "string"
        },
        "plan": {
          "type": "object",
          "required": [
            "finished_transfers",
            "production_jobs",
            "procurement_lots"
          ]
        },
        "audit": {
          "type": "object",
          "required": [
            "status",
            "checks_passed",
            "orders_protected",
            "unresolved_order_ids",
            "total_cost_cents"
          ],
          "properties": {
            "status": {
              "const": "PASSED"
            },
            "orders_protected": {
              "type": "integer",
              "minimum": 0
            },
            "total_cost_cents": {
              "type": "integer",
              "minimum": 0
            },
            "unresolved_order_ids": {
              "type": "array"
            }
          }
        },
        "objective_value": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        },
        "actions_executed": {
          "const": false
        },
        "recommendation_only": {
          "const": true
        }
      }
    }
  }
}
